{
  "kind": "collectionType",
  "collectionName": "licenses",
  "info": {
    "singularName": "license",
    "pluralName": "licenses",
    "displayName": "License"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "licenseNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "issueDate": {
      "type": "date",
      "required": true
    },
    "expiryDate": {
      "type": "date",
      "required": true
    },
    "issuer": {
      "type": "string",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  }
}
